# Copy to .env and fill in. All keys are optional; missing keys degrade to "not checked (no key)".

# VirusTotal v3 API key (free tier: 4 requests/minute, 500/day)
VT_API_KEY=

# URLhaus (abuse.ch) does not need a key for lookups. An Auth-Key raises rate limits if you have one.
URLHAUS_AUTH_KEY=

# Override the enrichment cache directory (default: ~/.cache/phishtriage)
# PHISHTRIAGE_CACHE_DIR=

# Max VirusTotal lookups per email (default 8). Flagged indicators are looked up first.
# VT_MAX_LOOKUPS=8
